<mxfile host="app.diagrams.net" type="device">
  <diagram id="ymmo-dns-ad" name="Résolution DNS — AD ymmo.lan">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Cheminement DNS dans Ymmo — le poste interroge le DNS de l'AD (ymmo.lan), qui répond en interne ou forwarde vers Internet" style="text;html=1;align=center;fontSize=16;fontStyle=1;fontColor=#212529;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1440" height="30" as="geometry" />
        </mxCell>

        <!-- VPC container -->
        <mxCell id="vpc" value="VPC Siège — ymmo.lan (eu-west-3)" style="rounded=1;arcSize=3;fillColor=#F7F8FA;strokeColor=#29B6D6;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#212529;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1080" height="680" as="geometry" />
        </mxCell>

        <!-- DHCP options -->
        <mxCell id="dhcp" value="DHCP options set du VPC&#10;DNS = IP des DC de l'AD&#10;(ex. 10.10.10.x · 10.10.10.y)" style="rounded=1;arcSize=10;fillColor=#F0AD4E;fontColor=#212529;strokeColor=#D89A3C;fontSize=13;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="110" width="280" height="90" as="geometry" />
        </mxCell>

        <!-- Poste client -->
        <mxCell id="poste" value="Poste / EC2 Windows&#10;(client joint au domaine)" style="rounded=1;arcSize=10;fillColor=#7DD4E8;fontColor=#212529;strokeColor=#5CC0D6;fontSize=14;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="110" y="330" width="240" height="100" as="geometry" />
        </mxCell>

        <!-- AD DNS -->
        <mxCell id="addns" value="AWS Managed Microsoft AD — DNS&#10;Zone PRIVÉE ymmo.lan (autoritaire)&#10;2 contrôleurs de domaine / 2 AZ" style="rounded=1;arcSize=10;fillColor=#7B68B8;fontColor=#FFFFFF;strokeColor=#6554A0;fontSize=14;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="320" width="320" height="120" as="geometry" />
        </mxCell>

        <!-- Réponse interne -->
        <mxCell id="interne" value="Question *.ymmo.lan&#10;→ RÉPONSE DIRECTE (interne)&#10;ex. serveur-fichiers.ymmo.lan = 10.10.10.5&#10;(noms auto-enregistrés à la jonction)" style="rounded=1;arcSize=10;fillColor=#A8E8D8;fontColor=#1B5E20;strokeColor=#80D0C0;fontSize=13;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="150" width="320" height="120" as="geometry" />
        </mxCell>

        <!-- Route53 resolver -->
        <mxCell id="r53" value="Route 53 Resolver (VPC, .2)" style="rounded=1;arcSize=10;fillColor=#29B6D6;fontColor=#FFFFFF;strokeColor=#1E8FA8;fontSize=14;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="470" width="320" height="70" as="geometry" />
        </mxCell>

        <!-- Internet (hors VPC) -->
        <mxCell id="internet" value="Internet&#10;(via NAT Gateway)" style="shape=cloud;fillColor=#3D4893;fontColor=#FFFFFF;strokeColor=#2D3570;fontSize=14;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="600" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- arrows -->
        <mxCell id="a_dhcp" value="configure le serveur&#10;DNS du poste" style="endArrow=block;endFill=1;dashed=1;strokeColor=#D89A3C;strokeWidth=1.5;fontSize=12;fontColor=#6C757D;html=1;" edge="1" parent="1" source="dhcp" target="poste"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="a_query" value="1. requête DNS&#10;(toutes les questions)" style="endArrow=block;endFill=1;strokeColor=#636E72;strokeWidth=2;fontSize=13;fontColor=#212529;fontStyle=1;html=1;" edge="1" parent="1" source="poste" target="addns"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="a_int" value="2a. *.ymmo.lan&#10;réponse interne" style="endArrow=block;endFill=1;strokeColor=#1B5E20;strokeWidth=2;fontSize=13;fontColor=#1B5E20;fontStyle=1;html=1;" edge="1" parent="1" source="addns" target="interne"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="a_fwd" value="2b. hors ymmo.lan&#10;→ FORWARD" style="endArrow=block;endFill=1;strokeColor=#1E8FA8;strokeWidth=2;fontSize=13;fontColor=#1E8FA8;fontStyle=1;html=1;" edge="1" parent="1" source="addns" target="r53"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="a_net" value="ex. google.com" style="endArrow=block;endFill=1;strokeColor=#636E72;strokeWidth=1.5;fontSize=12;fontColor=#6C757D;html=1;" edge="1" parent="1" source="r53" target="internet"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- note -->
        <mxCell id="note" value="Point clé : le DNS de ymmo.lan est PRIVÉ (n'existe pas sur Internet). Tant que le DHCP du VPC pointe vers AmazonProvidedDNS (état Phase 1), ymmo.lan est INRÉSOLVABLE → jonction de domaine impossible. Le repointage du DHCP vers le DNS de l'AD est l'étape qui débloque tout (step 02)." style="rounded=1;arcSize=6;fillColor=#FFF0E8;strokeColor=#D89A3C;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontColor=#212529;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="1080" height="110" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
