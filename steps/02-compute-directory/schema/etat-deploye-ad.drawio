        <mxCell id="grpFonc" value="5 groupes FONCTION (matrice des droits)&#10;GRP_Direction · GRP_Commercial · GRP_CommMktg · GRP_AdminRH · GRP_IT" style="rounded=1;arcSize=8;fillColor=#F0AD4E;fontColor=#212529;strokeColor=#D89A3C;fontSize=12;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
