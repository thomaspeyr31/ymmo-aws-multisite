<mxfile host="app.diagrams.net" type="device">
  <diagram id="ymmo-step02-ad" name="Step 02 — Compute + AD auto-géré">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Step 02 — Compute + Active Directory AUTO-GÉRÉ (ymmo.lan) · ce qui a été ajouté" style="text;html=1;align=center;fontSize=19;fontStyle=1;fontColor=#212529;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1680" height="34" as="geometry" />
        </mxCell>

        <!-- ===== Accès SSM (bandeau haut) ===== -->
        <mxCell id="ssm" value="Accès SANS port ouvert (région Paris) — SSM : Session Manager (terminal) · Fleet Manager (RDP navigateur) · Ansible aws_ssm" style="rounded=1;arcSize=10;fillColor=#29B6D6;fontColor=#FFFFFF;strokeColor=#1E8FA8;fontSize=14;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1640" height="42" as="geometry" />
        </mxCell>

        <!-- ============ INFRA (gauche) ============ -->
        <mxCell id="vpc" value="VPC Siège — subnet serveurs · 10.10.10.0/24 (2 AZ)" style="rounded=1;arcSize=4;fillColor=#FBFEFF;strokeColor=#29B6D6;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#212529;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="760" height="540" as="geometry" />
        </mxCell>

        <mxCell id="infra_lbl" value="INFRASTRUCTURE — Terraform" style="text;html=1;align=left;fontSize=13;fontStyle=2;fontColor=#6C757D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="400" height="20" as="geometry" />
        </mxCell>

        <mxCell id="dc" value="EC2 ec2-dc-siege — Windows Server 2022 FR&#10;Contrôleur de domaine + DNS&#10;IP fixe 10.10.10.10 · forêt ymmo.lan&#10;(promu par Ansible : Install-ADDSForest)" style="rounded=1;arcSize=8;fillColor=#3D4893;fontColor=#FFFFFF;strokeColor=#2D3570;fontSize=14;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="200" width="330" height="120" as="geometry" />
        </mxCell>

        <mxCell id="admin" value="EC2 ec2-admin-siege&#10;poste d'administration&#10;(membre du domaine, RSAT)" style="rounded=1;arcSize=8;fillColor=#7B68B8;fontColor=#FFFFFF;strokeColor=#6554A0;fontSize=14;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="200" width="320" height="120" as="geometry" />
        </mxCell>

        <mxCell id="sg" value="SG ymmo-dc — ports AD ouverts à 10.0.0.0/8 (siège + agences)&#10;DNS 53 · Kerberos 88/464 · LDAP 389/636 · SMB 445 · GC 3268/3269 · RPC 135 + dynamiques · NTP 123" style="rounded=1;arcSize=8;fillColor=#E8636A;fontColor=#FFFFFF;strokeColor=#D14F56;fontSize=13;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="350" width="690" height="70" as="geometry" />
        </mxCell>

        <mxCell id="iam" value="IAM : rôle + instance profile (AmazonSSMManagedInstanceCore) → instances SSM-managed&#10;DHCP : DNS Amazon (bascule vers le DC après promotion — var point_dhcp_to_dc)" style="rounded=0;fillColor=#F0F2F5;fontColor=#212529;strokeColor=#C8D0D8;fontSize=12;fontFamily=Helvetica;whiteSpace=wrap;html=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="440" width="690" height="60" as="geometry" />
        </mxCell>

        <mxCell id="prov" value="Provisionnement : Terraform (EC2, SG, IAM, DHCP) → Ansible (aws_ssm)&#10;• promote-dc.yml : promotion forêt ymmo.lan (async + auto-reboot) + forwarder DNS&#10;• ad-objects.yml : OU + groupes + utilisateurs (batch, 1 session, idempotent)" style="rounded=1;arcSize=8;fillColor=#FFF0E8;fontColor=#212529;strokeColor=#D89A3C;fontSize=13;fontFamily=Helvetica;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="520" width="690" height="120" as="geometry" />
        </mxCell>

        <!-- ============ ANNUAIRE (droite) ============ -->
        <mxCell id="ad_lbl" value="ANNUAIRE ymmo.lan — Ansible (modèle à 2 dimensions : FONCTION × SITE)" style="text;html=1;align=left;fontSize=13;fontStyle=2;fontColor=#6C757D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="840" y="160" width="700" height="20" as="geometry" />
