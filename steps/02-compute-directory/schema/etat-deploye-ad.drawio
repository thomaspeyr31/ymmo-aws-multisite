        <!-- note 2 dimensions -->
        <mxCell id="note2d" value="Chaque utilisateur = rangé dans l'OU de son SITE + membre de 2 groupes : son groupe FONCTION (accès dossiers) + son groupe SITE (GPO/local). 6 OU · 8 groupes · 10 utilisateurs." style="rounded=1;arcSize=6;fillColor=#A8E8D8;fontColor=#1B5E20;strokeColor=#80D0C0;fontSize=13;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
