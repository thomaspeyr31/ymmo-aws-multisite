<mxfile host="app.diagrams.net" type="device">
  <diagram id="ymmo-step04-fileserver" name="Step 04 — état déployé : serveur de fichiers + matrice des droits">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Step 04 — État déployé : serveur de fichiers FILESRV + matrice des droits (un partage SMB par groupe)" style="text;html=1;align=center;fontSize=18;fontStyle=1;fontColor=#212529;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1680" height="34" as="geometry" />
        </mxCell>

        <!-- ===== VPC Siège ===== -->
        <mxCell id="siege" value="VPC Siège · 10.10.0.0/16 — subnet serveurs 10.10.10.0/24" style="rounded=1;arcSize=4;fillColor=#FBFEFF;strokeColor=#29B6D6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#212529;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="70" width="620" height="470" as="geometry" />
        </mxCell>

        <mxCell id="dc" value="DC ymmo.lan&#10;10.10.10.10&#10;AD DS + DNS" style="rounded=1;arcSize=8;fillColor=#3D4893;fontColor=#FFFFFF;strokeColor=#2D3570;fontSize=13;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="120" width="170" height="90" as="geometry" />
        </mxCell>

        <!-- FILESRV -->
        <mxCell id="fs" value="EC2 ec2-fileserver-siege → renommé FILESRV&#10;Windows 2022 FR · 10.10.10.8 · joint à ymmo.lan" style="rounded=1;arcSize=6;fillColor=#1E8FA8;fontColor=#FFFFFF;strokeColor=#15707F;fontSize=13;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="590" y="240" width="560" height="280" as="geometry" />
        </mxCell>

        <!-- 5 partages -->
        <mxCell id="sh1" value="\\FILESRV\Direction   →  ACL NTFS = GRP_Direction" style="rounded=1;arcSize=10;fillColor=#EAF6FB;fontColor=#15707F;strokeColor=#7DD4E8;fontSize=12;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="615" y="300" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="sh2" value="\\FILESRV\Commercial   →  ACL NTFS = GRP_Commercial" style="rounded=1;arcSize=10;fillColor=#A8E8D8;fontColor=#1B5E20;strokeColor=#80D0C0;fontSize=12;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="615" y="338" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="sh3" value="\\FILESRV\CommMktg   →  ACL NTFS = GRP_CommMktg" style="rounded=1;arcSize=10;fillColor=#EAF6FB;fontColor=#15707F;strokeColor=#7DD4E8;fontSize=12;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="615" y="376" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="sh4" value="\\FILESRV\AdminRH   →  ACL NTFS = GRP_AdminRH" style="rounded=1;arcSize=10;fillColor=#F0A8AC;fontColor=#7A1F24;strokeColor=#D14F56;fontSize=12;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="615" y="414" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="sh5" value="\\FILESRV\IT   →  ACL NTFS = GRP_IT" style="rounded=1;arcSize=10;fillColor=#EAF6FB;fontColor=#15707F;strokeColor=#7DD4E8;fontSize=12;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="615" y="452" width="510" height="32" as="geometry" />
        </mxCell>

        <!-- deux couches -->
        <mxCell id="layers" value="Deux couches d'autorisation :&#10;• PARTAGE SMB = ouvert aux « Utilisateurs authentifiés » (la porte d'entrée)&#10;• NTFS = héritage coupé, autorise UNIQUEMENT GRP_&lt;Pôle&gt; (le vrai filtre)" style="rounded=1;arcSize=6;fillColor=#FFF8EE;strokeColor=#D89A3C;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;fontColor=#212529;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="440" height="110" as="geometry" />
        </mxCell>

        <!-- TGW -->
        <mxCell id="tgw" value="Transit Gateway&#10;(siège ↔ agences)" style="rounded=1;arcSize=10;fillColor=#29B6D6;fontColor=#FFFFFF;strokeColor=#1E8FA8;fontSize=13;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="640" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- poste Nîmes / acteur -->
        <mxCell id="poste" value="Poste Nîmes (ec2-poste-nimes)&#10;session ouverte : YMMO\marc.lefevre&#10;membre de GRP_Commercial" style="rounded=1;arcSize=8;fillColor=#FBFCFE;strokeColor=#B0B8C0;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="610" width="220" height="130" as="geometry" />
        </mxCell>

        <!-- test CT-04 résultats -->
        <mxCell id="okc" value="✓ \\FILESRV\Commercial — ACCÈS OK (lecture+écriture) : son pôle" style="rounded=1;arcSize=12;fillColor=#A8E8D8;fontColor=#1B5E20;strokeColor=#80D0C0;fontSize=13;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="600" width="540" height="40" as="geometry" />
        </mxCell>
        <mxCell id="koa" value="✗ \\FILESRV\AdminRH — ACCÈS REFUSÉ (NTFS) : autre pôle" style="rounded=1;arcSize=12;fillColor=#F0A8AC;fontColor=#7A1F24;strokeColor=#D14F56;fontSize=13;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=10;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="650" width="540" height="40" as="geometry" />
        </mxCell>

        <!-- arêtes -->
        <mxCell id="e_p_tgw" style="endArrow=none;strokeColor=#1E8FA8;strokeWidth=2.5;" edge="1" parent="1" source="poste" target="tgw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_tgw_ok" value="CT-04 (via TGW)" style="endArrow=block;endFill=1;strokeColor=#1B5E20;strokeWidth=2;fontSize=10;fontColor=#1B5E20;" edge="1" parent="1" source="tgw" target="okc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_tgw_ko" style="endArrow=block;endFill=1;dashed=1;strokeColor=#D14F56;strokeWidth=2;" edge="1" parent="1" source="tgw" target="koa"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- note bas -->
        <mxCell id="note" value="CT-04 : le même utilisateur, sur le même serveur → accès à SON partage, refus sur les autres. Les droits suivent l'IDENTITÉ AD (groupe GRP_Commercial), pas la machine ni le partage. Modèle « un espace partagé par groupe », scripté Terraform (EC2) + Ansible (jonction, partages, ACL). Accessible depuis les agences via le TGW (SMB 445)." style="rounded=1;arcSize=6;fillColor=#EEF0F8;fontColor=#212529;strokeColor=#2D3570;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="770" width="1600" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
