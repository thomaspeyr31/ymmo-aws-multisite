<mxfile host="app.diagrams.net" type="device">
  <diagram id="ymmo-step03-valid" name="Step 03 — validation routes + réflexion sécurité">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Step 03 — Validation : la segmentation vient du ROUTAGE TGW · et faut-il vraiment un pare-feu ?" style="text;html=1;align=center;fontSize=18;fontStyle=1;fontColor=#212529;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="20" y="8" width="1680" height="30" as="geometry" />
        </mxCell>

        <!-- Siège -->
        <mxCell id="siege" value="VPC Siège (HUB)&#10;10.10.0.0/16" style="rounded=1;arcSize=6;fillColor=#FBFEFF;strokeColor=#29B6D6;strokeWidth=2;fontSize=14;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="730" y="120" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rthub" value="rt-hub (associée au siège)&#10;routes apprises : 10.10/16 · 10.21/16 · 10.22/16&#10;➜ le siège voit les 3 sites" style="rounded=1;arcSize=8;fillColor=#EEF0F8;strokeColor=#2D3570;fontSize=12;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="225" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- TGW -->
        <mxCell id="tgw" value="AWS Transit Gateway&#10;tgw-058ec5867…" style="rounded=1;arcSize=10;fillColor=#29B6D6;fontColor=#FFFFFF;strokeColor=#1E8FA8;fontSize=15;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="730" y="320" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rtspokes" value="rt-spokes (associée aux 2 agences)&#10;route apprise : 10.10/16 UNIQUEMENT&#10;➜ une agence ne route QUE vers le siège" style="rounded=1;arcSize=8;fillColor=#FFF0E8;strokeColor=#D89A3C;fontSize=12;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="425" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- Agences -->
        <mxCell id="mars" value="VPC Marseille&#10;10.21.0.0/16" style="rounded=1;arcSize=6;fillColor=#FBFCFE;strokeColor=#B0B8C0;fontSize=14;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="330" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="nimes" value="VPC Nîmes&#10;10.22.0.0/16" style="rounded=1;arcSize=6;fillColor=#FBFCFE;strokeColor=#B0B8C0;fontSize=14;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1300" y="330" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- attachments -->
        <mxCell id="a_s" value="attachment" style="endArrow=none;strokeColor=#1E8FA8;strokeWidth=2.5;fontSize=11;fontColor=#1E8FA8;" edge="1" parent="1" source="siege" target="tgw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a_m" value="attachment" style="endArrow=none;strokeColor=#1E8FA8;strokeWidth=2.5;fontSize=11;fontColor=#1E8FA8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="mars" target="tgw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a_n" value="attachment" style="endArrow=none;strokeColor=#1E8FA8;strokeWidth=2.5;fontSize=11;fontColor=#1E8FA8;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="nimes" target="tgw"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- flux autorisés / interdit -->
        <mxCell id="ok_m" value="✓ siège ↔ Marseille" style="rounded=1;arcSize=20;fillColor=#A8E8D8;fontColor=#1B5E20;strokeColor=#80D0C0;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="440" y="285" width="170" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ok_n" value="✓ siège ↔ Nîmes" style="rounded=1;arcSize=20;fillColor=#A8E8D8;fontColor=#1B5E20;strokeColor=#80D0C0;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1110" y="285" width="170" height="34" as="geometry" />
        </mxCell>
        <mxCell id="block" value="" style="endArrow=none;startArrow=none;dashed=1;dashPattern=6 6;strokeColor=#E8636A;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="mars" target="nimes"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="560" /><mxPoint x="1410" y="560" /></Array></mxGeometry></mxCell>
        <mxCell id="block_lbl" value="✗ Marseille ↛ Nîmes — aucune route dans rt-spokes (segmentation par le routage)" style="rounded=1;arcSize=12;fillColor=#F0A8AC;fontColor=#7A1F24;strokeColor=#D14F56;fontSize=12;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="540" width="560" height="40" as="geometry" />
        </mxCell>

        <!-- note tous les flux passent -->
        <mxCell id="note_flux" value="⚠️ État actuel : TOUS LES FLUX AUTORISÉS PASSENT (routage + ports ouverts par les SG), SANS inspection de contenu (pas de pare-feu L7). Seules barrières : routage (segmentation) + Security Groups (ports)." style="rounded=1;arcSize=6;fillColor=#FFF8EE;strokeColor=#D89A3C;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#212529;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="1600" height="44" as="geometry" />
        </mxCell>

        <!-- ===== réflexion sécurité (2 colonnes) ===== -->
        <mxCell id="sec_title" value="Faut-il vraiment un pare-feu (step 4) ? — la sécurité est dimensionnée par l'OUVERTURE vers l'extérieur" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#212529;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="1600" height="24" as="geometry" />
        </mxCell>

        <mxCell id="col_intra" value="&lt;b&gt;Aujourd'hui : 100 % intra-AWS&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Le trafic ne touche JAMAIS Internet (backbone privé AWS)&lt;br&gt;• Serveurs sans IP publique ; accès admin par SSM (IAM)&lt;br&gt;• Segmentation agence↔agence déjà faite par le TGW&lt;br&gt;&lt;br&gt;➜ Un pare-feu = surtout de la &lt;b&gt;défense en profondeur&lt;/b&gt;&lt;br&gt;(inspection L7, anti-exfiltration, filtrage de domaines).&lt;br&gt;&lt;b&gt;Utile, mais pas vital&lt;/b&gt; tant que rien n'entre ni ne sort." style="rounded=1;arcSize=6;fillColor=#A8E8D8;fontColor=#1B5E20;strokeColor=#80D0C0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=13;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="690" width="780" height="250" as="geometry" />
        </mxCell>

        <mxCell id="col_ext" value="&lt;b&gt;Dès qu'on ouvre vers l'EXTÉRIEUR&lt;/b&gt; (poste nomade, agence on-prem, sortie Internet)&lt;br&gt;&lt;br&gt;Le périmètre s'étend au &lt;b&gt;réseau public&lt;/b&gt; → la sécurité devient NÉCESSAIRE :&lt;br&gt;&lt;br&gt;• &lt;b&gt;IPSec&lt;/b&gt; pour faire entrer ces accès chiffrés :&lt;br&gt;&#160;&#160;– Site-to-Site VPN (agence on-prem)&lt;br&gt;&#160;&#160;– Client VPN (poste nomade)&lt;br&gt;• &lt;b&gt;AWS Network Firewall&lt;/b&gt; pour inspecter ce qui franchit la FRONTIÈRE (entrant/sortant)&lt;br&gt;&lt;br&gt;➜ C'est l'objet du &lt;b&gt;STEP 4&lt;/b&gt; (Network Firewall + option IPSec) — ce que le sujet anticipe avec « VPN/IPSec »." style="rounded=1;arcSize=6;fillColor=#FFF0E8;fontColor=#212529;strokeColor=#D89A3C;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=13;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="690" width="780" height="250" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
