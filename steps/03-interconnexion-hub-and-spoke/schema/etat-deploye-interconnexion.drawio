<mxfile host="app.diagrams.net" type="device">
  <diagram id="ymmo-step03-etat" name="Step 03 — état déployé : interconnexion hub-and-spoke">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
