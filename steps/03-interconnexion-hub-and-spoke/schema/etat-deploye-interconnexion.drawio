          <mxGeometry x="910" y="130" width="170" height="110" as="geometry" />
        </mxCell>

        <!-- rt-hub -->
        <mxCell id="rthub" value="rt-hub (associée au siège) — apprend 10.10/16 · 10.21/16 · 10.22/16 ➜ le siège atteint les 3 sites" style="rounded=1;arcSize=8;fillColor=#EEF0F8;strokeColor=#2D3570;fontSize=12;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
