        <!-- attachments -->
        <mxCell id="a_s" value="attachment" style="endArrow=none;strokeColor=#1E8FA8;strokeWidth=2.5;fontSize=11;fontColor=#1E8FA8;" edge="1" parent="1" source="siege" target="tgw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a_m" value="attachment" style="endArrow=none;strokeColor=#1E8FA8;strokeWidth=2.5;fontSize=11;fontColor=#1E8FA8;" edge="1" parent="1" source="pmars" target="tgw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a_n" value="attachment" style="endArrow=none;strokeColor=#1E8FA8;strokeWidth=2.5;fontSize=11;fontColor=#1E8FA8;" edge="1" parent="1" source="pnimes" target="tgw"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- flux jonction (poste -> DC) -->
        <mxCell id="join_m" value="jonction → DC (DNS/Kerberos/LDAP/SMB)" style="endArrow=block;endFill=1;dashed=1;strokeColor=#1B5E20;strokeWidth=2;fontSize=10;fontColor=#1B5E20;" edge="1" parent="1" source="pmars" target="dc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="560" /></Array></mxGeometry></mxCell>
        <mxCell id="join_n" value="jonction → DC" style="endArrow=block;endFill=1;dashed=1;strokeColor=#1B5E20;strokeWidth=2;fontSize=10;fontColor=#1B5E20;" edge="1" parent="1" source="pnimes" target="dc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1410" y="560" /></Array></mxGeometry></mxCell>

        <!-- agence ↛ agence -->
        <mxCell id="block" value="" style="endArrow=none;startArrow=none;dashed=1;dashPattern=6 6;strokeColor=#E8636A;strokeWidth=3;" edge="1" parent="1" source="mars" target="nimes"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="880" /><mxPoint x="1410" y="880" /></Array></mxGeometry></mxCell>
        <mxCell id="block_lbl" value="✗ Marseille ↛ Nîmes — aucune route dans rt-spokes (segmentation par le ROUTAGE, sans pare-feu)" style="rounded=1;arcSize=12;fillColor=#F0A8AC;fontColor=#7A1F24;strokeColor=#D14F56;fontSize=13;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="855" width="600" height="44" as="geometry" />
        </mxCell>

        <!-- légende / note de synthèse -->
        <mxCell id="note" value="Provisionnement 100 % scripté — Terraform (TGW, attachments, route tables, routes VPC, EC2 postes) puis Ansible/SSM (jonction : NIC→DNS du DC, Add-Computer, reboot ; comptes ordinateur vérifiés côté DC).  ✓ La jonction d'un poste d'agence au DC du siège PROUVE la connectivité siège↔agence via le TGW.  Postes NON nominatifs : identité au login (l'AD porte droits/groupes).  Tous les flux autorisés passent SANS inspection L7 → pare-feu/IPSec = step 04." style="rounded=1;arcSize=6;fillColor=#A8E8D8;fontColor=#1B5E20;strokeColor=#80D0C0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="915" width="1480" height="70" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
