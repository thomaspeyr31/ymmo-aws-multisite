        <mxCell id="title" value="Step 03 — État déployé : siège (Aix) et agences (Marseille, Nîmes) reliés par le Transit Gateway · postes joints à ymmo.lan" style="text;html=1;align=center;fontSize=18;fontStyle=1;fontColor=#212529;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1680" height="34" as="geometry" />
