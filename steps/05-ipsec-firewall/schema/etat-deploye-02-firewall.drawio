<mxfile host="app.diagrams.net" type="device">
  <diagram id="ymmo-step05-fw" name="Step 05 (2/2) — filtrage egress (Network Firewall)">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="940" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Step 05 (2/2) — Filtrage des flux SORTANTS : AWS Network Firewall (illustré par le blocage de Facebook)" style="text;html=1;align=center;fontSize=18;fontStyle=1;fontColor=#212529;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1680" height="34" as="geometry" />
        </mxCell>
        <mxCell id="goal" value="Objectif de cette brique : INSPECTER / FILTRER ce qui franchit la frontière (egress du siège). Indépendant de l'accès nomade (schéma 1/2)." style="text;html=1;align=center;fontSize=13;fontStyle=2;fontColor=#6C757D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="20" y="44" width="1680" height="20" as="geometry" />
        </mxCell>

        <!-- sources -->
        <mxCell id="src" value="Émetteurs (egress du SIÈGE)" style="rounded=1;arcSize=6;fillColor=#FBFEFF;strokeColor=#29B6D6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#212529;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="330" height="380" as="geometry" />
        </mxCell>
        <mxCell id="srv" value="Serveurs siège&#10;DC · ec2-admin-siege · FILESRV" style="rounded=1;arcSize=8;fillColor=#3D4893;fontColor=#FFFFFF;strokeColor=#2D3570;fontSize=12;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="170" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="nomad" value="Nomade connecté au VPN&#10;(tunnel complet → egress siège)" style="rounded=1;arcSize=8;fillColor=#1E8FA8;fontColor=#FFFFFF;strokeColor=#15707F;fontSize=12;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="290" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="nat" value="NAT GW / subnet public&#10;route 0/0 → endpoint pare-feu" style="rounded=1;arcSize=8;fillColor=#EEF0F8;fontColor=#212529;strokeColor=#2D3570;fontSize=12;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="395" width="270" height="70" as="geometry" />
        </mxCell>

        <!-- firewall -->
        <mxCell id="fw" value="AWS Network Firewall&#10;ymmo-egress-firewall&#10;(endpoint dans subnet 10.10.30.0/28)&#10;inspection SNI / HTTP Host" style="rounded=1;arcSize=8;fillColor=#E8636A;fontColor=#FFFFFF;strokeColor=#D14F56;fontSize=14;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="230" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="Règle stateful (DENYLIST) :&#10;✗ *.facebook.com&#10;✗ *.tiktok.com&#10;✓ tout le reste (SSM, MAJ, web pro…)" style="rounded=1;arcSize=6;fillColor=#FFF0E8;fontColor=#212529;strokeColor=#D89A3C;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="400" width="320" height="110" as="geometry" />
        </mxCell>

        <!-- IGW + internet -->
        <mxCell id="igw" value="IGW&#10;(subnet pare-feu : 0/0 → IGW ;&#10;edge : public/25 → pare-feu, retour stateful)" style="rounded=1;arcSize=8;fillColor=#7B68B8;fontColor=#FFFFFF;strokeColor=#6554A0;fontSize=12;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1050" y="160" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ok" value="✓ example.com → 200" style="rounded=1;arcSize=10;fillColor=#A8E8D8;fontColor=#1B5E20;strokeColor=#80D0C0;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1370" y="160" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ko" value="✗ facebook.com → timeout (bloqué)" style="rounded=1;arcSize=10;fillColor=#F0A8AC;fontColor=#7A1F24;strokeColor=#D14F56;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1370" y="215" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="inet" value="INTERNET" style="rounded=1;arcSize=6;fillColor=#F0F2F5;strokeColor=#C8D0D8;fontSize=13;fontStyle=2;fontColor=#6C757D;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1410" y="280" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- arêtes -->
        <mxCell id="e1" style="endArrow=classic;strokeColor=#6C757D;strokeWidth=2;" edge="1" parent="1" source="srv" target="nat"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=classic;strokeColor=#6C757D;strokeWidth=2;" edge="1" parent="1" source="nomad" target="nat"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="0/0" style="endArrow=classic;strokeColor=#D14F56;strokeWidth=3;fontSize=11;fontColor=#D14F56;" edge="1" parent="1" source="nat" target="fw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="autorisé → IGW" style="endArrow=classic;strokeColor=#1B5E20;strokeWidth=2.5;fontSize=11;fontColor=#1B5E20;" edge="1" parent="1" source="fw" target="igw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="endArrow=classic;strokeColor=#6554A0;strokeWidth=2;" edge="1" parent="1" source="igw" target="inet"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- comment tester -->
        <mxCell id="test" value="DEUX façons de tester (CT-06) — au choix :&#10;A) Depuis le NOMADE : VPN connecté → ouvrir facebook.com (bloqué) vs un site pro (passe).&#10;B) Depuis un POSTE WINDOWS DU SIÈGE (ec2-admin-siege, Fleet Manager RDP) → idem.&#10;(Les deux empruntent l'egress du siège, donc le pare-feu.)" style="rounded=1;arcSize=6;fillColor=#EEF0F8;strokeColor=#2D3570;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;fontStyle=1;fontColor=#212529;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="820" height="120" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="⚠️ Périmètre : seul l'egress du SIÈGE est inspecté. Les postes d'AGENCE (Marseille/Nîmes) sortent par leur propre NAT/IGW → NON filtrés.&#10;En PRODUCTION, un pare-feu devrait être déployé PAR AGENCE (ou egress des agences routé vers le siège via le TGW — « hub d'inspection »).&#10;NON mis en place ici pour des raisons de COÛT : ~10 €/jour PAR pare-feu (cf. docs/notes/estimation-couts.md)." style="rounded=1;arcSize=6;fillColor=#FFF8EE;strokeColor=#D89A3C;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;fontColor=#212529;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="545" width="740" height="135" as="geometry" />
        </mxCell>

        <!-- log -->
        <mxCell id="log" value="Journalisation : flux + alertes (domaines bloqués) → CloudWatch /ymmo/network-firewall." style="text;html=1;align=left;fontSize=12;fontStyle=2;fontColor=#6C757D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="1580" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
