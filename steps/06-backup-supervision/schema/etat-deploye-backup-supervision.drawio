<mxfile host="app.diagrams.net" type="device">
  <diagram id="ymmo-step06" name="Step 06 — backup et supervision">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="940" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Step 06 — État déployé : plan de sauvegarde (AWS Backup) + supervision (CloudWatch)" style="text;html=1;align=center;fontSize=18;fontStyle=1;fontColor=#212529;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1680" height="34" as="geometry" />
        </mxCell>

        <!-- ressources sources -->
        <mxCell id="srv" value="Serveurs critiques du siège (tag Backup=true)&#10;DC ymmo.lan 10.10.10.10  ·  FILESRV 10.10.10.8" style="rounded=1;arcSize=8;fillColor=#3D4893;fontColor=#FFFFFF;strokeColor=#2D3570;fontSize=13;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="nopost" value="Postes (siège + agences) = NON sauvegardés&#10;(jetables, données centralisées sur FILESRV)" style="rounded=1;arcSize=8;fillColor=#F0F2F5;fontColor=#6C757D;strokeColor=#C8D0D8;fontSize=12;fontStyle=2;fontFamily=Helvetica;whiteSpace=wrap;html=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="360" height="60" as="geometry" />
        </mxCell>

        <!-- AWS BACKUP (service managé) -->
        <mxCell id="backup" value="AWS BACKUP — service MANAGÉ (serverless)" style="rounded=1;arcSize=4;fillColor=#FBFEFF;strokeColor=#1E8FA8;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#15707F;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="520" y="100" width="560" height="360" as="geometry" />
        </mxCell>
        <mxCell id="sel" value="① Selection « ymmo-tagged »&#10;QUOI : tag Backup=true" style="rounded=1;arcSize=8;fillColor=#A8E8D8;fontColor=#1B5E20;strokeColor=#80D0C0;fontSize=12;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="150" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="plan" value="② Plan « ymmo-plan »&#10;daily-7d (cron 02:00, gardé 7j)&#10;weekly-35d (dim 03:00, gardé 35j)" style="rounded=1;arcSize=8;fillColor=#EEF0F8;fontColor=#212529;strokeColor=#2D3570;fontSize=12;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="150" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="role" value="③ Rôle « ymmo-backup »&#10;AWS l'assume pour lire + snapshot" style="rounded=1;arcSize=8;fillColor=#FFF0E8;fontColor=#212529;strokeColor=#D89A3C;fontSize=12;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="250" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="vault" value="④ Vault « ymmo-vault » (chiffré KMS)&#10;stocke les recovery points (AMI+EBS)&#10;expiration AUTO (7j / 35j)" style="rounded=1;arcSize=8;fillColor=#1E8FA8;fontColor=#FFFFFF;strokeColor=#15707F;fontSize=12;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="250" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cn" value="« Cloud-natif » : le planificateur + la découverte par tag + les jobs + la rétention sont OPÉRÉS PAR AWS. On-prem, ce serait un serveur de backup (Veeam…) à installer/patcher/superviser. Ici : zéro serveur." style="rounded=1;arcSize=6;fillColor=#FFF8EE;strokeColor=#D89A3C;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#212529;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="340" width="500" height="100" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="sauvegarde quotidienne" style="endArrow=classic;strokeColor=#1B5E20;strokeWidth=2.5;fontSize=11;fontColor=#1B5E20;" edge="1" parent="1" source="srv" target="backup"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- SUPERVISION -->
        <mxCell id="sup" value="SUPERVISION — Amazon CloudWatch" style="rounded=1;arcSize=4;fillColor=#FBFCFE;strokeColor=#7B68B8;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#6554A0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1150" y="100" width="500" height="360" as="geometry" />
        </mxCell>
        <mxCell id="metrics" value="Métriques EC2 (DC · FILESRV · admin · VPN)&#10;StatusCheckFailed · CPUUtilization" style="rounded=1;arcSize=8;fillColor=#EEF0F8;fontColor=#212529;strokeColor=#6554A0;fontSize=12;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="150" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="alarms" value="8 alarmes : status check KO + CPU &gt; 85%" style="rounded=1;arcSize=8;fillColor=#F0A8AC;fontColor=#7A1F24;strokeColor=#D14F56;fontSize=12;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="230" width="440" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sns" value="Topic SNS « ymmo-alerts » → email (optionnel)" style="rounded=1;arcSize=8;fillColor=#F0AD4E;fontColor=#212529;strokeColor=#D89A3C;fontSize=12;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="300" width="440" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dash" value="Dashboard « ymmo » (CPU + status checks)" style="rounded=1;arcSize=8;fillColor=#7DD4E8;fontColor=#212529;strokeColor=#5CC0D6;fontSize=12;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="370" width="440" height="50" as="geometry" />
        </mxCell>
        <mxCell id="es1" style="endArrow=classic;strokeColor=#6554A0;strokeWidth=1.5;" edge="1" parent="1" source="metrics" target="alarms"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="es2" style="endArrow=classic;strokeColor=#6554A0;strokeWidth=1.5;" edge="1" parent="1" source="alarms" target="sns"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- bandeau périmètre -->
        <mxCell id="note" value="Périmètre backup = la VALEUR (données FILESRV + annuaire DC), pas les postes. Sélection PAR TAG → répétable (un destroy/apply re-tague et la couverture revient). Restauration : depuis le vault, un recovery point → nouvelle EC2/EBS." style="rounded=1;arcSize=6;fillColor=#A8E8D8;fontColor=#1B5E20;strokeColor=#80D0C0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="1590" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
