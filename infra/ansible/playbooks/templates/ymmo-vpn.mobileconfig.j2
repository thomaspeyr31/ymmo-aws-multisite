<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>PayloadDisplayName</key><string>Ymmo VPN nomade (IKEv2)</string>
  <key>PayloadIdentifier</key><string>lan.ymmo.vpn</string>
  <key>PayloadType</key><string>Configuration</string>
  <key>PayloadUUID</key><string>A1111111-1111-1111-1111-111111111111</string>
  <key>PayloadVersion</key><integer>1</integer>
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>PayloadType</key><string>com.apple.security.root</string>
      <key>PayloadIdentifier</key><string>lan.ymmo.vpn.ca</string>
      <key>PayloadUUID</key><string>A2222222-2222-2222-2222-222222222222</string>
      <key>PayloadVersion</key><integer>1</integer>
      <key>PayloadDisplayName</key><string>Ymmo VPN CA</string>
      <key>PayloadCertificateFileName</key><string>ymmo-ca.cer</string>
      <key>PayloadContent</key>
      <data>
{{ ca_cert_der_b64 }}
      </data>
    </dict>
    <dict>
      <key>PayloadType</key><string>com.apple.vpn.managed</string>
      <key>PayloadIdentifier</key><string>lan.ymmo.vpn.ikev2</string>
      <key>PayloadUUID</key><string>A3333333-3333-3333-3333-333333333333</string>
      <key>PayloadVersion</key><integer>1</integer>
      <key>PayloadDisplayName</key><string>Ymmo VPN nomade</string>
      <key>UserDefinedName</key><string>Ymmo VPN nomade</string>
      <key>VPNType</key><string>IKEv2</string>
      <key>IKEv2</key>
      <dict>
        <key>RemoteAddress</key><string>{{ vpn_public_ip }}</string>
        <key>RemoteIdentifier</key><string>{{ vpn_public_ip }}</string>
        <key>LocalIdentifier</key><string>{{ vpn_eap_user }}</string>
        <key>AuthenticationMethod</key><string>None</string>
        <key>ExtendedAuthEnabled</key><integer>1</integer>
        <key>AuthName</key><string>{{ vpn_eap_user }}</string>
        <key>AuthPassword</key><string>{{ vpn_eap_password }}</string>
        <key>ServerCertificateIssuerCommonName</key><string>Ymmo VPN CA</string>
        <key>DeadPeerDetectionRate</key><string>Medium</string>
        <key>EnablePFS</key><false/>
        <key>IKESecurityAssociationParameters</key>
        <dict>
          <key>EncryptionAlgorithm</key><string>AES-256</string>
          <key>IntegrityAlgorithm</key><string>SHA2-256</string>
          <key>DiffieHellmanGroup</key><integer>14</integer>
        </dict>
        <key>ChildSecurityAssociationParameters</key>
        <dict>
          <key>EncryptionAlgorithm</key><string>AES-256</string>
          <key>IntegrityAlgorithm</key><string>SHA2-256</string>
          <key>DiffieHellmanGroup</key><integer>14</integer>
        </dict>
      </dict>
    </dict>
  </array>
</dict>
</plist>
